# LOBBY CAM environment variables
#
# Copy this file to .env.local for local dev, or paste these into Railway's
# "Variables" tab for production. Every one is OPTIONAL — the site runs in
# demo mode without them and each feed "lights up" once its key is present.
# Check which feeds are live at /status.
#
# See docs/ENV_SETUP.md for step-by-step instructions on getting each key.

# Bills & floor schedule (Congress.gov). Free key from https://api.data.gov/signup/
CONGRESS_GOV_API_KEY=

# Donor money by industry (OpenSecrets). Free key (200 calls/day) from
# https://www.opensecrets.org/api/admin/index.php?function=signup
OPENSECRETS_API_KEY=

# Campaign filings (FEC). Free key from https://api.data.gov/signup/
# (the same api.data.gov key works for both Congress.gov and FEC)
FEC_API_KEY=
